rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: public read access, write allowed for authenticated users/admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() || request.auth != null;
    }

    // Orders: public create for checkout, read if signed in or matching user
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Users: owner or signed-in read/write
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Newsletters: public create
    match /newsletters/{newsletterId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
    
    // Connection test doc
    match /test/connection {
      allow read: if true;
    }
  }
}
