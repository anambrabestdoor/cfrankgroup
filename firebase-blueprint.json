{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Skincare item in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "image": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "badge": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "stock": { "type": "number" }
      },
      "required": ["name", "price", "image", "category", "active", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 200 },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "customerName", "items", "total", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "newsletterSubscribed": { "type": "boolean" },
        "joinDate": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "Newsletter": {
      "title": "Newsletter",
      "description": "Subscribed newsletter email address",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "subscribedAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog items for Anua Skincare."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchase orders."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account profiles."
    },
    "/newsletters/{newsletterId}": {
      "schema": { "$ref": "#/entities/Newsletter" },
      "description": "Newsletter subscribers."
    }
  }
}
