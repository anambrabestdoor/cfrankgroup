# =========================================================================
# ANAMBRA BEST DOOR (CFrank Enterprise) — Environment Configuration Template
# =========================================================================
# Copy this file to .env.local for local development.
# On Vercel or production servers, add these keys in Project Settings > Environment Variables.
# NEVER commit your actual .env or .env.local file to Git.

# -------------------------------------------------------------------------
# 1. Application URLs & Environment
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://anambrabestdoor.com
NODE_ENV=development

# -------------------------------------------------------------------------
# 2. Resend API (Transactional Order Confirmations & Contact Inquiries)
# -------------------------------------------------------------------------
# Get your free API key at: https://resend.com/api-keys
# When empty, inquiries operate via direct WhatsApp ordering and local logging.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Anambra Best Door <orders@anambrabestdoor.com>"
RESEND_REPLY_TO_EMAIL="anambrabestdoor@gmail.com"
ADMIN_NOTIFICATION_EMAIL=anambrabestdoor@gmail.com

# -------------------------------------------------------------------------
# 3. Cloudinary Integration (Product Photography & Depot Showcase)
# -------------------------------------------------------------------------
# Create a free account at: https://cloudinary.com
# Used by the Admin Dashboard for direct media uploading of doors and fittings.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------------------------
# 4. Supabase Database (Products, Inventory & Audit Logs)
# -------------------------------------------------------------------------
# Create your database project at: https://supabase.com
# Run the migration file in 'supabase_schema.sql' to initialize tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------------------
# 5. Frankie AI Assistant (Gemini & Multi-Model Cascade)
# -------------------------------------------------------------------------
# Get your free Google Gemini API key at: https://aistudio.google.com/apikey
# If empty, Frankie runs smoothly on the built-in deterministic local intelligence engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-pro

# -------------------------------------------------------------------------
# 6. Admin Authentication & Security
# -------------------------------------------------------------------------
JWT_SECRET=super-secure-random-jwt-secret-min-32-chars-long
ADMIN_EMAIL=anambrabestdoor@gmail.com
ADMIN_PASSWORD=AdminPassword2026!
