# =========================================================================
# CFRANK GROUP — Environment Configuration Template
# =========================================================================
# Copy this file to .env.local for local development.
# On Vercel or production servers, add these keys in Project Settings > Environment Variables.
# NEVER commit your actual .env or .env.local file to Git.

# -------------------------------------------------------------------------
# 1. Brand Configuration (Centralised — no scattered hardcoded values)
# -------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="CFrank Group"
NEXT_PUBLIC_BRAND_SHORT_NAME="CFrank"
NEXT_PUBLIC_BRAND_TAGLINE="Everything to build, secure, and complete your space."
NEXT_PUBLIC_BRAND_DESCRIPTION="We deliver quality security doors, stone-coated roof tiles, smart biometric door locks, and sanitary wares; building project supply in one order."
NEXT_PUBLIC_BRAND_EMAIL="info@cfrankgroup.com"
NEXT_PUBLIC_BRAND_PHONE="+2347070070305"
NEXT_PUBLIC_BRAND_PHONE_DISPLAY="+234 707 007 0305"
NEXT_PUBLIC_BRAND_WHATSAPP="2347070070305"
NEXT_PUBLIC_BRAND_ADDRESS="No. 16/17 Maraim Plaza, Building Materials International Market, Ogidi, Anambra State, Nigeria"
NEXT_PUBLIC_BRAND_PROPRIETOR="Chidera Frank Okonkwo"
NEXT_PUBLIC_BRAND_CAC_NUMBER="BN 9943925"
NEXT_PUBLIC_BRAND_WORKING_HOURS="Mon - Sat: 8:00 AM - 5:30 PM"
NEXT_PUBLIC_SITE_URL="https://cfrankgroup.com"

# Social links
NEXT_PUBLIC_SOCIAL_FACEBOOK="https://www.facebook.com/Anambrabestdoor/"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://www.instagram.com/anambrabestdoor/"
NEXT_PUBLIC_SOCIAL_TWITTER=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_JIJI=""

# -------------------------------------------------------------------------
# 2. Application URLs & Environment
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -------------------------------------------------------------------------
# 3. Paystack Integration (Commerce Payments)
# -------------------------------------------------------------------------
# Get your keys at: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# -------------------------------------------------------------------------
# 4. Resend API (Transactional Order Confirmations & Notifications)
# -------------------------------------------------------------------------
# Get your free API key at: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="CFrank Group <orders@cfrankgroup.com>"
RESEND_REPLY_TO_EMAIL="info@cfrankgroup.com"
ADMIN_NOTIFICATION_EMAIL=info@cfrankgroup.com

# -------------------------------------------------------------------------
# 5. Cloudinary Integration (Product Photography & Media)
# -------------------------------------------------------------------------
# Create a free account at: https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------------------------
# 6. Supabase Database (Products, Inventory & Audit Logs)
# -------------------------------------------------------------------------
# Create your database project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------------------
# 7. AI Assistant (Gemini & Multi-Model Cascade)
# -------------------------------------------------------------------------
# Get your free Google Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-pro

# -------------------------------------------------------------------------
# 8. Admin Authentication & Security
# -------------------------------------------------------------------------
JWT_SECRET=super-secure-random-jwt-secret-min-32-chars-long
ADMIN_EMAIL=admin@cfrankgroup.com
ADMIN_PASSWORD=AdminPassword2026!
