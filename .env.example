# Anambra Best Door (CFrank Enterprise) Environment Template
# Copy this file to .env.local and fill in your actual production values
# NEVER commit .env.local to Git

# Application URLs
NEXT_PUBLIC_APP_URL=https://anambrabestdoor.com
APP_URL=https://anambrabestdoor.com

# Support & Showroom Contacts
NEXT_PUBLIC_SUPPORT_EMAIL=sales@anambrabestdoor.com
SUPPORT_EMAIL=sales@anambrabestdoor.com
NEXT_PUBLIC_WHATSAPP_NUMBER=2348031971334

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
NODE_ENV=development

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key

# Image CDN (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
